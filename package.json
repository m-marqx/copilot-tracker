{
  "name": "copilot-premium-tracker",
  "displayName": "Copilot Premium Request Tracker",
  "description": "Track GitHub Copilot Premium request usage with pacing progress in the status bar and a detailed analytics dashboard.",
  "version": "0.0.6",
  "author": "Archie Marques",
  "publisher": "m-marqx",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/m-marqx/copilot-tracker.git"
  },
  "keywords": [
    "github copilot",
    "premium requests",
    "usage tracking"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Copilot Premium Tracker",
      "properties": {
        "copilot-premium-tracker.statusBarMode": {
          "type": "string",
          "enum": [
            "pacer",
            "classic"
          ],
          "default": "pacer",
          "enumDescriptions": [
            "Pacer bar with today marker and remaining-today count",
            "Classic progress bar with actual% / target%"
          ],
          "description": "Status bar display mode."
        }
      }
    },
    "commands": [
      {
        "command": "copilot-premium-tracker.showDashboard",
        "title": "Show Copilot Premium Request Dashboard",
        "category": "Copilot Tracker"
      },
      {
        "command": "copilot-premium-tracker.refresh",
        "title": "Refresh Usage Data from GitHub API",
        "category": "Copilot Tracker"
      },
      {
        "command": "copilot-premium-tracker.addModel",
        "title": "Add Model Usage Entry",
        "category": "Copilot Tracker"
      },
      {
        "command": "copilot-premium-tracker.setLimit",
        "title": "Set Monthly Premium Request Limit",
        "category": "Copilot Tracker"
      },
      {
        "command": "copilot-premium-tracker.resetData",
        "title": "Reset All Usage Data",
        "category": "Copilot Tracker"
      },
      {
        "command": "copilot-premium-tracker.setBillingToken",
        "title": "Set Billing Token (Fine-Grained PAT with Plan Permission)",
        "category": "Copilot Tracker"
      },
      {
        "command": "copilot-premium-tracker.clearBillingToken",
        "title": "Clear Billing Token",
        "category": "Copilot Tracker"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "lint": "tsc --noEmit",
    "deploy": "npm install && npm run compile && vsce package && vsce publish"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.5.0",
    "@types/sinon": "^21.0.1",
    "@types/vscode": "^1.85.0",
    "chai": "^6.2.2",
    "esbuild": "^0.24.0",
    "mocha": "^11.7.5",
    "sinon": "^21.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "axios": "1.14.0"
  }
}
